\begin{tikzpicture}
    \begin{axis}[
        height = 0.45\textheight, % висота малюнка 45% від висоти сторінки
        width = \textwidth, % ширина малюнка є шириною сторінки
        xlabel = {Момент часу~$t$},
        ylabel = {Значення},
        % scale only axis,
        xmin = -0.1, xmax = 2.6,
        ymin = 0.2, ymax = 1.1,
        xtick distance = 0.25,
        % ytick distance = 0.25,
        % scaled y ticks = base 10:4,
        yticklabel style = {
            /pgf/number format/.cd,
            fixed,
            fixed zerofill,
            precision=1, % округлення позначки вісей до одного значку після коми
            /tikz/.cd
        },
        xticklabel style = {
            /pgf/number format/.cd,
            fixed,
            fixed zerofill,
            precision=2, % округлення позначки вісей до другого значку після коми
            /tikz/.cd
        },
        grid = both,
        grid style = {draw=gray!30},
        minor grid style = {draw=gray!10},
        minor x tick num = 4, % кількість мінорних міток на вісі абсцис
        minor y tick num = 1, % кількість мінорних міток на вісі ординат
        legend style = {
            at={(0.975,0.95)}, % позиція легенди на малюнку (відносно ширини/висоти графка)
            font=\footnotesize, % шрифт тексту у легенді
            anchor=north east, % локація "якора", відносно якого відліковується позиція легенди
            cells={anchor=west} % вирівнювання тексту (ліворуч)
        },
    ]

    \addplot[blue, smooth, line width=1pt, domain=0:2.5]{
        0.3 * cos(deg(5 * x)) + 0.6
    };
    \addlegendentry{\ Функція $\cos(t)$};

    \addplot[black, mark=*, mark size=2pt, line width=1pt] table[
        x=t,
        y=value,
        col sep=comma
    ] {Data/plot.csv};
    \addlegendentry{\ Поточковий графік};

    \end{axis}
\end{tikzpicture}